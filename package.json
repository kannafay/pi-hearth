{
  "name": "pi-hearth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "desktop:build": "tauri build",
    "desktop:standalone": "tauri build --debug --no-bundle",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:guard": "node --test tests/tool-guard.spec.node.mjs",
    "test:sessions": "node --test tests/session-catalog.spec.node.mjs",
    "test:files": "node --test tests/file-storage.spec.node.mjs",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:guard && pnpm test:sessions && pnpm test:files && pnpm format:check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:rpc:live": "cargo test --manifest-path src-tauri/Cargo.toml live_rpc_conversation_and_stop -- --ignored --nocapture",
    "test:tools:live": "cargo test --manifest-path src-tauri/Cargo.toml live_rpc_tools_and_approval -- --ignored --nocapture",
    "test:sessions:live": "cargo test --manifest-path src-tauri/Cargo.toml live_native_sessions_and_projects -- --ignored --nocapture",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@streamdown/code": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "overlayscrollbars": "^2.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.6",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^27",
    "oxlint": "^1",
    "prettier": "^3",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
